# Everything is optional. The defaults run the whole stack locally against mocks.
# docker compose reads .env by itself; for local runs, export what you need.

# --- shared -------------------------------------------------------------------
TOLLGATE_LOG_LEVEL=INFO

# --- task 1: MCP server ---------------------------------------------------------
# 1 = every handler tries to write junk to stdout (print, os.write(1), a child
# process). For proving the stdio isolation, never for real use.
TOLLGATE_CHAOS_STDOUT=0

# --- task 2: MCP gateway ----------------------------------------------------------
TOLLGATE_DOWNSTREAM_URL=http://127.0.0.1:8801/mcp
# HS256 secret for client JWTs. The dev default is in auth.py; set a real one.
TOLLGATE_JWT_SECRET=
# Token the gateway presents to the downstream (the client's never is).
TOLLGATE_DOWNSTREAM_TOKEN=
# TOML policy file, see examples/policy.toml. Unset = admin_* needs admin.
TOLLGATE_POLICY=
# off | warn | enforce
TOLLGATE_TOOL_PINS=warn
# Roles whose tool results get PII redacted.
TOLLGATE_REDACT_ROLES=viewer
# 1 = hide tools a role can't call from tools/list.
TOLLGATE_FILTER_TOOLS_LIST=0
# Browser origins allowed besides localhost (comma separated).
TOLLGATE_ALLOWED_ORIGINS=

# --- tasks 3 + 4: LLM gateway --------------------------------------------------------
# Any OpenAI-compatible endpoint. Leave blank for the local mocks on :8831/:8832.
TOLLGATE_PRIMARY_BASE_URL=
TOLLGATE_PRIMARY_API_KEY=
TOLLGATE_PRIMARY_MODEL=
TOLLGATE_SECONDARY_BASE_URL=
TOLLGATE_SECONDARY_API_KEY=
TOLLGATE_SECONDARY_MODEL=
# Per-attempt deadline before failing over.
TOLLGATE_PROVIDER_TIMEOUT_S=3.0
# Client API keys, key:tenant pairs, comma separated.
TOLLGATE_TENANT_KEYS=tg-dev-acme:acme,tg-dev-globex:globex
TOLLGATE_TPM_LIMIT=50000
TOLLGATE_DB=data/ratelimit.sqlite3
# 0 = pass streams through unredacted (for benchmarking only).
TOLLGATE_REDACT=1
# 1 = [REDACTED:EMAIL] instead of [REDACTED].
TOLLGATE_LABELED_REDACTIONS=0
# Seconds of provider silence mid-stream before giving up on it.
TOLLGATE_STREAM_IDLE_S=30
